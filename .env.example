# Wave instance configuration. Copy to .env.local and fill in.
# Placeholders only: never commit real values.

# Public origin of this instance. Used to render the join prompt and channel URLs.
# On Vercel this can be left unset: the deployment's own origin is used, so a
# preview points at itself. Set it once a real domain is attached.
HOST=http://localhost:3000

# Any Redis 6 or later. TTLs, INCR, and sorted sets are the only features used.
REDIS_URL=redis://localhost:6379

# Shared secret the cron sweep route requires. Generate with: openssl rand -base64 32
CRON_SECRET=replace-me-with-32-random-bytes

# Namespace in front of every Redis key. Default: wave. Change it to run two
# instances, or another app, against one Redis without collisions.
REDIS_PREFIX=wave

# Sign-in (optional). Leave all four unset and the instance runs without
# accounts, exactly as before. Set all four to turn it on; setting some is an
# error the first sign-in request reports. Sign-in on adds a Postgres beside
# Redis: see docs/SELF-HOSTING.md.
#
# Generate with: openssl rand -base64 32
# AUTH_SECRET=replace-me-with-32-random-bytes
# Postgres 14 or later. On Vercel the marketplace sets this (POSTGRES_URL is read too).
# DATABASE_URL=postgres://wave:wave@localhost:5432/wave
# SMTP, for the magic link. smtp:// or smtps://, credentials in the URL.
# EMAIL_URL=smtp://user:pass@mail.example.com:587
# EMAIL_FROM=Wave <no-reply@wave.example.com>
